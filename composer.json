{
    "name": "netium/panel-networking",
    "type": "project",
    "description": "Panel de administración ISP (CodeIgniter 4)",
    "license": "proprietary",
    "require": {
        "php": "^8.2",
        "ext-curl": "*",
        "ext-intl": "*",
        "ext-mbstring": "*",
        "ext-mysqli": "*",
        "codeigniter4/framework": "^4.7",
        "firebase/php-jwt": "^7.2",
        "mpdf/mpdf": "^8.3",
        "mpdf/qrcode": "^1.2",
        "pear2/cache_shm": "@beta",
        "pear2/console_color": "@beta",
        "pear2/net_routeros": "1.0.0b6@beta",
        "pear2/net_transmitter": "@beta",
        "phpoffice/phpspreadsheet": "^5.10",
        "phpseclib/phpseclib": "^3.0"
    },
    "require-dev": {
        "fakerphp/faker": "^1.9",
        "mikey179/vfsstream": "^1.6.12",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^10.5.16"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Config\\": "app/Config/",
            "SMSGatewayMe\\Client\\": "app/Libraries/sms-gateway/smsgatewayme/client/lib/"
        },
        "exclude-from-classmap": [
            "**/Database/Migrations/**",
            "app/Libraries/"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\Support\\": "tests/_support"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "platform": {
            "php": "8.2.12"
        }
    },
    "scripts": {
        "test": "phpunit",
        "phpstan": "phpstan analyse -c phpstan.neon.dist --memory-limit=2G"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
