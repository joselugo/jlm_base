# DATABASE
#--------------------------------------------------------------------

# Conexión principal. La usan CI4, Class_connet, los crons (cron/env.php)
# y los scripts de shell. Única fuente de credenciales de BD.
database.default.hostname = localhost
database.default.port = 3306
database.default.database = moloch
database.default.username =
database.default.password =

# BD de la versión anterior (Mikrowisp5), usada por Model_cotizaciones
database.version5.hostname =
database.version5.port = 3306
database.version5.database = Mikrowisp5
database.version5.username =
database.version5.password =

# sql_mode de sesión (app y crons). Por defecto el de MariaDB 10.1 (producción),
# porque hay consultas que MySQL 8 rechaza con ONLY_FULL_GROUP_BY.
# database.sqlMode = NO_ENGINE_SUBSTITUTION

