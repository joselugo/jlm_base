#--------------------------------------------------------------------
# INTEGRACIONES (app/Config/Integraciones.php)
#--------------------------------------------------------------------

# Conekta: llave PRIVADA de la cuenta productiva (key_...)
integraciones.conektaPrivateKey =

# SMTP para envío de cotizaciones
integraciones.smtpHost =
integraciones.smtpUser =
integraciones.smtpPass =
integraciones.smtpPort = 587
# Nombre del remitente de las cotizaciones (el correo es smtpUser)
integraciones.smtpFromName = Cotizaciones

# Firebase Cloud Messaging (server key)
integraciones.fcmServerKey =

# Dropbox (backups)
integraciones.dropboxKey =
integraciones.dropboxSecret =
integraciones.dropboxToken =

# SMSGateway (API antigua por usuario/contraseña)
integraciones.smsgatewayEmail =
integraciones.smsgatewayPassword =

# MikroTik usado por Api::uroboros
integraciones.mikrotikHost =
integraciones.mikrotikUser =
integraciones.mikrotikPass =
integraciones.mikrotikPort = 8728

# CMTS (SSH) para consultar/reiniciar cable módems (Herramientas)
integraciones.cmtsHost =
integraciones.cmtsUser =
integraciones.cmtsPass =
integraciones.cmtsPort = 22

#--------------------------------------------------------------------
# JWT (por defecto rsa/private.rsa y rsa/public.rsa.pub)
#--------------------------------------------------------------------

# Generar (RSA 2048 o más; php-jwt 7 rechaza claves menores):
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out rsa/private.rsa
#   openssl rsa -in rsa/private.rsa -pubout -out rsa/public.rsa.pub
# jwt.privateKeyPath = /ruta/fuera/del/webroot/private.rsa
# jwt.publicKeyPath = /ruta/fuera/del/webroot/public.rsa.pub

#--------------------------------------------------------------------
# CRONS (cron/env.php y grafico/update_emisores.sh leen este mismo .env)
#--------------------------------------------------------------------

# URL base del panel donde el cron inicia sesión para obtener el token
# (antes fija: http://app.netium.com.mx/herramientas)
cron.panelUrl =
cron.panelUser =
cron.panelPassword =

# Servidor Socket.IO que recibe el estado online/offline
cron.socketUrl = http://localhost:2001

